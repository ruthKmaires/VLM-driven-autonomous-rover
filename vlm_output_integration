import requests

VLM_URL = "http://<vlm-server-ip>:5000/analyze"
ESP32_IP = "http://<esp32-ip>/"

# Maps VLM's "command" field → ESP32 keyword
COMMAND_MAP = {
    "forward": "FORWARD",
    "stop": "STOP",
    "turn_left": "LEFT",
    "turn_right": "RIGHT",
    "speed low": "SLOW"
}

def get_vlm_command(frame_jpeg_bytes):
    files = {'image': ('frame.jpg', frame_jpeg_bytes, 'image/jpeg')}
    try:
        response = requests.post(VLM_URL, files=files, timeout=20)
        if response.status_code == 200:
            data = response.json()
            return data.get("command", "stop")
    except Exception as e:
        print(f"VLM server error: {e}")
    return "stop"

def send_to_esp32(vlm_command):
    esp_cmd = COMMAND_MAP.get(vlm_command, "STOP")
    try:
        requests.get(f"{ESP32_IP}?cmd={esp_cmd}", timeout=0.5)
        print(f"Sent to ESP32: {esp_cmd}")
    except requests.exceptions.RequestException as e:
        print(f"ESP32 send error: {e}")

def control_loop(capture_frame_fn):
    while True:
        frame = capture_frame_fn()
        vlm_cmd = get_vlm_command(frame)
        print(f"VLM says: {vlm_cmd}")
        send_to_esp32(vlm_cmd)
